# Copy to deploy/.env, or run `make langfuse-env` to generate one with random values.
# deploy/.env is git-ignored. Docker Compose reads it, and so does the app:
#   uv run --env-file deploy/.env pricing-watch ...

# the Langfuse release is pinned in docker-compose.yml; set LANGFUSE_IMAGE_TAG here to override

# store passwords and Langfuse server secrets
POSTGRES_PASSWORD=CHANGEME
CLICKHOUSE_PASSWORD=CHANGEME
REDIS_PASSWORD=CHANGEME
MINIO_PASSWORD=CHANGEME
NEXTAUTH_SECRET=CHANGEME
SALT=CHANGEME
# 64 hex characters: openssl rand -hex 32
ENCRYPTION_KEY=CHANGEME

# the project's API keys, created on first start; the SDK reads the same variables
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGEME
LANGFUSE_SECRET_KEY=sk-lf-CHANGEME
LANGFUSE_BASE_URL=http://localhost:3000
# the Collector's auth header to Langfuse: base64 of "<public key>:<secret key>"
LANGFUSE_OTLP_AUTH=CHANGEME
# the app sends spans here, to the local Collector, which forwards them to Langfuse
OTEL_COLLECTOR_ENDPOINT=http://localhost:4318/v1/traces

# UI login: admin@pricing-watch.local with this password
LANGFUSE_ADMIN_PASSWORD=CHANGEME
